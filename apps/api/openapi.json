  "components": {
    "schemas": {
      "AssetCompleteResponse": {
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid",
            "title": "Assetid"
          },
          "status": {
            "$ref": "#/components/schemas/AssetStatus"
          }
        },
        "type": "object",
        "required": [
          "assetId",
          "status"
        ],
        "title": "AssetCompleteResponse"
      },
      "AssetPurpose": {
        "type": "string",
        "enum": [
          "profile-image",
          "situational-image"
        ],
        "title": "AssetPurpose",
        "description": "techspec-backend-media.md §1. Extend as new upload flows need a purpose."
      },
      "AssetStatus": {
        "type": "string",
        "enum": [
          "pending",
          "ready"
        ],
        "title": "AssetStatus",
        "description": "techspec-backend-media.md §1: row is created pending at presigned-upload\ntime, and flipped to ready once POST /assets/{id}/complete confirms the S3\nobject exists."
      },
      "GuardianConsentRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "guardianName": {
            "type": "string",
            "minLength": 1,
