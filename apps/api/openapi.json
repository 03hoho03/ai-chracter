              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profileimageassetid"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "nickname",
          "bio",
          "profileImageAssetId"
        ],
        "title": "MeResponse"
      },
      "OnboardingGoogleRequest": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "title": "Nickname"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "title": "Birthdate"
          },
          "termsAgreed": {
            "type": "boolean",
            "title": "Termsagreed"
          },
          "privacyAgreed": {
