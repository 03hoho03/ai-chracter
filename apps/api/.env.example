# API 가 읽는 env 키 전부. `./dev-up.sh` 가 이 파일을 `.env` 로 복사하고, 복사본 그대로 로컬에서 뜬다.
# 활성 줄은 로컬 기동에 필요한 값이고, `# KEY=값` 주석 줄은 선택 키다(적힌 값이 코드 기본값 — 기본값이
# 없는 키는 예시 값과 함께 "기본: 없음"이라고 적는다). 쓰려면 주석을 풀고 값을 채운다.
# 형식 규칙(값 없는 `KEY=` 금지, 값 속 따옴표·$·공백 금지 등)과 검사 명령 `pnpm check:env` 는 DEV.md 의
# "env 파일 형식" 절에 있다. 이 파일과 코드가 읽는 키가 어긋나면 CI 가 떨어뜨린다.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_character_chat
REDIS_URL=redis://localhost:6379/0
# 로그인·채팅에 필요한 비밀 값. 로컬에서 Google 로그인·채팅을 하려면 주석을 풀고 채운다.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 카카오 로그인. REST API 키·클라이언트 시크릿이 비면 카카오 로그인 시작이 로그인 화면 오류로
# 돌아온다. 어드민 키는 탈퇴 시 연결 끊기와 연결 해제 웹훅 인증에 쓰며 대표(Primary) 어드민 키여야 한다.
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_ADMIN_KEY=
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# GEMINI_API_KEY=

# 집 PC 자가 호스팅 이미지 생성 서버. base_url은 Cloudflare Tunnel 호스트명,
# access_client_id/secret은 Cloudflare Access 서비스 토큰.
# LOCAL_IMAGE_BASE_URL=
# LOCAL_IMAGE_ACCESS_CLIENT_ID=
# LOCAL_IMAGE_ACCESS_CLIENT_SECRET=
# 집 PC 가 보고하는 실제 id. 기본값은 공개 id 와 같아 로컬은 주석으로 둔다.
# LOCAL_IMAGE_MODEL_WIRE_ID=v1
# 집 PC 호출 타임아웃(초)·capabilities 캐시 수명(초)·전 워커 합계 대기열 상한.
# LOCAL_IMAGE_TIMEOUT_SECONDS=90
# LOCAL_IMAGE_CAPABILITIES_TTL_SECONDS=30
# LOCAL_IMAGE_QUEUE_LIMIT=4
# 본인 생성 이미지를 참조로 싣는 기능의 스위치. 서버가 참조를 받는다고 확인된 뒤에만 켠다.
# LOCAL_IMAGE_REFERENCE_ENABLED=false
# 생성 잡 Redis 레코드 수명(초).
# IMAGE_GENERATION_JOB_TTL_SECONDS=3600

# 이메일 발송. 기본값 console(발송 없이 로그만 찍음) —
# resend로 바꾸면 RESEND_API_KEY/EMAIL_FROM이 필요하다.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM=noreply@ddona.site
# 이메일 인증 코드 수명(초)과 재발송 대기(초), 비밀번호 재설정 토큰 수명(초).
# EMAIL_VERIFICATION_CODE_TTL_SECONDS=900
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# --- 로컬 개발용 에셋 저장소 (docker-compose.dev.yml 의 moto) ---
# S3_ENDPOINT_URL 은 모든 환경에서 필수다 — 프로덕션은 R2 엔드포인트(`https://<accountid>.r2.cloudflarestorage.com`)를
# 넣는다. 빈 값이면 API 가 기동하지 못하고, 아예 없으면 이미지 GET 주소 서명이 실패한다.
S3_ENDPOINT_URL=http://localhost:5001
# boto3 는 presigned URL "서명"에도 자격증명이 존재해야 한다(더미값이면 충분, moto 는 검증 안 함).
# 이 값들은 pydantic 이 아니라 boto3 가 프로세스 env 로 읽으므로, 반드시 `uv run --env-file .env ...`
# 로 서버/시드를 실행해 .env 가 프로세스 환경에 주입되게 한다.
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_REGION=ap-northeast-2
# 버킷 이름과 GET 주소 서명 수명(초). 로컬 moto 버킷은 docker-compose.dev.yml 이 이 기본 이름으로 만든다.
# S3_BUCKET_NAME=ai-character-chat-assets-dev
# S3_PRESIGNED_URL_EXPIRES_SECONDS=900

# --- 선택: 기본값으로 로컬이 돈다 ---
# 워커 하나의 DB 풀 크기·넘침·대기(초). 워커 수 × (풀 + 넘침)이 Postgres 연결 상한을 넘지 않게 한다.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# 워커 하나에서 동시에 도는 이미지 디코드·변형 건수.
# IMAGE_DECODE_CONCURRENCY=3
# /docs·/openapi.json 노출. 운영에서는 절대 켜지 않는다. 로컬에서 API 문서를 보려면 true.
# EXPOSE_API_DOCS=false
# 세션 쿠키. Secure 는 HTTPS 에서만 붙으므로 로컬은 false(배포 환경은 true).
# SESSION_COOKIE_NAME=session_id
# SESSION_TTL_SECONDS=604800
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# ADMIN_SESSION_COOKIE_NAME=admin_session_id
# CORS 허용 오리진, 쉼표 구분(공백 없이). 기본값이 로컬 web·admin 오리진이다.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174
# 탈퇴 재가입 차단 HMAC 키. 운영은 무작위 값을 한 번 정해 바꾸지 않는다. 로컬은 비워 둬도 돈다.
# WITHDRAWN_EMAIL_HMAC_KEY=
# OAuth 왕복·온보딩 대기 수명(초).
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# GOOGLE_PENDING_SIGNUP_TTL_SECONDS=900
# KAKAO_OAUTH_STATE_TTL_SECONDS=600
# KAKAO_PENDING_SIGNUP_TTL_SECONDS=900
# 채팅 생성 모델과 출력 상한(사고 토큰 포함).
# GEMINI_MODEL_NAME=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=8192
# 사고 예산. 기본: 없음(사고 설정을 넘기지 않음), 0 = 사고 끔, 양수 = 그 토큰까지.
# GEMINI_THINKING_BUDGET=1024
# 판정·발행 심사만 다른 모델로. 기본: 없음(GEMINI_MODEL_NAME 을 쓴다).
# GEMINI_STAT_JUDGMENT_MODEL_NAME=gemini-2.5-flash
# GEMINI_ENDING_JUDGMENT_MODEL_NAME=gemini-2.5-flash
# GEMINI_IMAGE_JUDGMENT_MODEL_NAME=gemini-2.5-flash
# GEMINI_PUBLISH_FILTER_MODEL_NAME=gemini-2.5-flash
# Gemini 호출 타임아웃(ms). 생성 / 판정 / 기억 요약 / 발행 심사 / 클라이언트 기본값(안전망).
# GEMINI_GENERATE_TIMEOUT_MS=45000
# GEMINI_JUDGMENT_TIMEOUT_MS=20000
# GEMINI_MEMORY_SUMMARY_TIMEOUT_MS=60000
# GEMINI_PUBLISH_FILTER_TIMEOUT_MS=60000
# GEMINI_CLIENT_TIMEOUT_MS=60000
# 소설화 장 생성·문단 수정의 모델·출력 상한(사고 토큰 포함)·사고 설정(예산 또는 MINIMAL/LOW/MEDIUM/HIGH). 사고 설정 기본: 없음.
# 장 경계 제안은 GEMINI_MODEL_NAME 을 쓴다.
# GEMINI_NOVELIZE_MODEL_NAME=gemini-3.5-flash
# GEMINI_NOVELIZE_MAX_OUTPUT_TOKENS=32768
# 사고 예산과 사고 수준은 둘 중 하나만 정한다(둘 다 있으면 기동하지 않는다).
# GEMINI_NOVELIZE_THINKING_BUDGET=
# GEMINI_NOVELIZE_THINKING_LEVEL=
# 소설화 호출 타임아웃(ms). 장 생성 / 문단 수정 / 장 경계 제안.
# GEMINI_NOVELIZE_CHAPTER_TIMEOUT_MS=300000
# GEMINI_NOVELIZE_REVISE_TIMEOUT_MS=120000
# GEMINI_NOVELIZE_BOUNDARY_TIMEOUT_MS=30000
# 회차 재현용 생성 시드. 기본: 없음(매 회차 난수).
# GEMINI_SEED=42
# 조립된 프롬프트를 JSONL 로 남길 경로. 기본: 없음(남기지 않음). 창작자 비공개 설정이 담긴다.
# PROMPT_DUMP_PATH=/tmp/prompt-dump.jsonl
# 빌더 미리보기 세션 수명(초).
# PREVIEW_SESSION_TTL_SECONDS=86400
# 조회수 중복 제거용 게스트 쿠키와 중복 제거 창(초).
# GUEST_VIEWER_COOKIE_NAME=guest_viewer_id
# GUEST_VIEWER_COOKIE_MAX_AGE_SECONDS=31536000
# CONTENT_VIEW_DEDUP_TTL_SECONDS=86400
# 활성 프롬프트 세트 캐시 수명(초).
# PROMPT_SET_CACHE_TTL_SECONDS=300
# 히스토리 윈도우 스위치(생성 / 엔딩 판정 / 그림 매칭 판정 — 상황 이미지·미디어 북 칸). false 는 되돌리기용.
# MEMORY_WINDOW_GENERATION=true
# MEMORY_WINDOW_ENDING_JUDGMENT=true
# MEMORY_WINDOW_IMAGE_JUDGMENT=true
# 소설화 전역 스위치와 허용 가능 계정 id 명단(쉼표 구분, 따옴표 없이). 기본: 꺼짐·빈 명단(아무도 못 씀).
# NOVELIZE_ENABLED=false
# NOVELIZE_GRANT_ALLOWLIST=
# 같은 장(같은 시작 메시지)을 하루(KST)에 만들 수 있는 횟수 — 장 생성·재생성 합, 진행 중·성공만 센다.
# NOVELIZE_CHAPTER_DAILY_LIMIT=5
# 소설화 작업 heartbeat 주기·만료(초), 작업 전체 상한(초), 장 본문 최소 글자 수, 직전 장 끝 발췌 목표 길이(글자). 모두 임시값.
# NOVELIZE_HEARTBEAT_INTERVAL_SECONDS=10
# NOVELIZE_HEARTBEAT_EXPIRY_SECONDS=60
# NOVELIZE_JOB_TIMEOUT_SECONDS=360
# NOVELIZE_MIN_CHAPTER_CHARS=200
# NOVELIZE_PREVIOUS_EXCERPT_CHARS=1000
# 장 하나의 원문 턴 상한(경계 제안 후보 수), 경계 제안 시간당 상한. 둘 다 임시값.
# NOVELIZE_CHAPTER_MAX_TURNS=12
# NOVELIZE_PROPOSAL_HOURLY_LIMIT=30
# 에러 추적. DSN 이 비면 꺼진다. 로컬·워크트리에 운영 DSN 을 넣지 않는다(이 .env 는 워크트리로 복사된다).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# uvicorn 이 직접 읽는다. 신뢰할 프록시 대역과 워커 수 — 운영 값은 DEPLOY.md 의 "BE 런타임" 절.
# FORWARDED_ALLOW_IPS=127.0.0.1
# WEB_CONCURRENCY=1
