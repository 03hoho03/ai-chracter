{
  "openapi": "3.1.0",
  "info": {
    "title": "chat-lab-service",
    "version": "1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "살아 있음만 알린다 — DB·판·설정 어느 것도 싣지 않는다. 토큰을 보지 않는다.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Health",
        "description": "살아 있음만 알린다 — DB·판·설정 어느 것도 싣지 않는다. 토큰을 보지 않는다.",
        "operationId": "health_api_health_head",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "summary": "Get Runs",
        "operationId": "get_runs_api_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}/versions": {
      "get": {
        "summary": "Get Versions",
        "description": "지우지 않은 판, 최신 먼저. 지우지 않은 판이 없으면 404.",
        "operationId": "get_versions_api_runs__runId__versions_get",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,1024}$",
              "title": "Runid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionList"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload",
        "description": "판 올리기 — 신원 → runId 꼴 → 머리(본문을 읽기 전) → 선언 길이 → 실제로 읽은 길이 → 풀기·sha·JSON → 묶음 모양 → DB.",
        "operationId": "upload_api_runs__runId__versions_post",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,1024}$",
              "title": "Runid"
            }
          },
          {
            "name": "X-Lab-Upload-Header",
            "in": "header",
            "required": true,
            "description": "측정 서버 올리기 머리 응답 JSON 그대로({sourceCommit, provenance})",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          },
          "200": {
            "description": "같은 내용이 이미 있거나(exists) 지운 판을 되살렸다(restored)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "이 서비스의 거부(reason 있음) 또는 요청 검증 오류(reason 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ServiceError"
                    },
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "측정 서버 통째 응답(RunBundle) JSON 바이트의 gzip",
          "content": {
            "application/gzip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}/versions/{sha256}/bundle": {
      "get": {
        "summary": "Get Bundle",
        "operationId": "get_bundle_api_runs__runId__versions__sha256__bundle_get",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,1024}$",
              "title": "Runid"
            }
          },
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "측정 서버 통째 응답(RunBundle) 그대로. gzip 을 받는 쪽에는 올린 gzip 바이트 그대로(Content-Encoding: gzip), 아니면 풀어서 보낸다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Get Bundle",
        "operationId": "get_bundle_api_runs__runId__versions__sha256__bundle_head",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,1024}$",
              "title": "Runid"
            }
          },
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "측정 서버 통째 응답(RunBundle) 그대로. gzip 을 받는 쪽에는 올린 gzip 바이트 그대로(Content-Encoding: gzip), 아니면 풀어서 보낸다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}": {
      "delete": {
        "summary": "Remove Run",
        "description": "그 런의 살아 있는 판을 모두 지운다. 지울 판이 없으면 404.",
        "operationId": "remove_run_api_runs__runId__delete",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,1024}$",
              "title": "Runid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "이 서비스의 거부(reason 있음) 또는 요청 검증 오류(reason 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ServiceError"
                    },
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "경로와 같은 runId — 폼·text/plain 교차 사이트 요청으로는 지울 수 없게 JSON 본문을 요구한다",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "runId"
                ],
                "properties": {
                  "runId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteResult": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "deletedVersions": {
            "type": "integer",
            "title": "Deletedversions"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "deletedVersions"
        ],
        "title": "DeleteResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Provenance": {
        "properties": {
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "baseLocal": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baselocal"
          },
          "roomFound": {
            "type": "boolean",
            "title": "Roomfound"
          },
          "ownerInExampleDomain": {
            "type": "boolean",
            "title": "Ownerinexampledomain"
          },
          "outsideUsers": {
            "type": "integer",
            "title": "Outsideusers"
          },
          "exemptedUsers": {
            "type": "integer",
            "title": "Exemptedusers"
          },
          "authorInExampleDomain": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorinexampledomain"
          }
        },
        "type": "object",
        "required": [
          "passed",
          "baseLocal",
          "roomFound",
          "ownerInExampleDomain",
          "outsideUsers",
          "exemptedUsers",
          "authorInExampleDomain"
        ],
        "title": "Provenance",
        "description": "이 런이 로컬 측정 서버에서 테스트 계정으로만 돈 것인지. 측정 서버가 낸 칸 가운데 이 일곱만 저장한다."
      },
      "RunItem": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "latest": {
            "$ref": "#/components/schemas/Version"
          },
          "versionCount": {
            "type": "integer",
            "title": "Versioncount"
          },
          "run": {
            "additionalProperties": true,
            "type": "object",
            "title": "Run"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "latest",
          "versionCount",
          "run"
        ],
        "title": "RunItem"
      },
      "RunList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "RunList"
      },
      "ServiceError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "reason": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "notFound",
              "tooLarge",
              "notGzip",
              "notJsonObject",
              "noUploadHeader",
              "badUploadHeader",
              "provenanceFailed",
              "noContractVersion",
              "unsupportedContract",
              "legacyFormat",
              "badBundle",
              "runIdMismatch",
              "badDeleteBody",
              "keysUnavailable",
              "dbUnavailable",
              "internal"
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "reason"
        ],
        "title": "ServiceError"
      },
      "SourceCommit": {
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
            "title": "Commit"
          },
          "dirty": {
            "type": "boolean",
            "title": "Dirty"
          }
        },
        "type": "object",
        "required": [
          "commit",
          "dirty"
        ],
        "title": "SourceCommit",
        "description": "묶음을 만든 측정 서버 checkout 의 커밋."
      },
      "UploadResult": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "exists",
              "restored"
            ],
            "title": "Status"
          },
          "versionNumber": {
            "type": "integer",
            "title": "Versionnumber"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "sha256",
          "status",
          "versionNumber"
        ],
        "title": "UploadResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Version": {
        "properties": {
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "versionNumber": {
            "type": "integer",
            "title": "Versionnumber"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Uploadedat"
          },
          "uploadedBy": {
            "type": "string",
            "title": "Uploadedby"
          },
          "raw": {
            "type": "boolean",
            "title": "Raw"
          },
          "contractVersion": {
            "type": "integer",
            "title": "Contractversion"
          },
          "sourceCommit": {
            "$ref": "#/components/schemas/SourceCommit"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "compressedSize": {
            "type": "integer",
            "title": "Compressedsize"
          },
          "uncompressedSize": {
            "type": "integer",
            "title": "Uncompressedsize"
          }
        },
        "type": "object",
        "required": [
          "sha256",
          "versionNumber",
          "uploadedAt",
          "uploadedBy",
          "raw",
          "contractVersion",
          "sourceCommit",
          "provenance",
          "compressedSize",
          "uncompressedSize"
        ],
        "title": "Version"
      },
      "VersionList": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/Version"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "versions"
        ],
        "title": "VersionList"
      }
    }
  }
}
