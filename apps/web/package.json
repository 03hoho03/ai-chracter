{
  "name": "@ai-character-chat/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --platform=neutral --outfile=dist/_worker.js",
    "typecheck": "tsc --noEmit",
    "dev:worker": "wrangler pages dev dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-character-chat/api-types": "workspace:*",
    "@ai-character-chat/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "axios": "^1.18.1",
    "jotai": "^2.20.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-call": "^2.0.2",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-use": "^17.6.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-character-chat/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.1.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.124.0"
  }
}
