# GCE VM 앞단 리버스 프록시. Let's Encrypt 인증서를 자동 발급·갱신한다.
#
# `SITE_ADDRESS` 가 이 파일의 유일한 변수다:
#   프로덕션  SITE_ADDRESS=api.ddona.site   → 자동 HTTPS(80은 443으로 리다이렉트)
#   로컬 검증 SITE_ADDRESS=http://localhost → 평문(인증서 발급 시도 안 함)
#
# ⚠️ 도메인을 쓸 때 Cloudflare DNS의 프록시(주황 구름)가 켜져 있으면 챌린지가 도달하지 못해
# 발급이 무한 실패한다. 반드시 DNS only(회색)로 둘 것.

{$SITE_ADDRESS} {
	# 브라우저 에러 ingest(monitoring-techspec.md MT-3). web은 Bugsink(도커 내부 네트워크,
	# 포트 미게시)에 직접 못 닿으므로 Cloudflare Worker가 `ddona.site/_ingest/*`를 이 도메인으로
	# 중계한다. `api.ddona.site`는 ACME 때문에 Cloudflare DNS only(회색 구름) 강제라 WAF·
	# 레이트리밋 보호 밖이다.
	#
	# `BUGSINK_BASE_URL`이 `/_ingest`가 붙은 값(`https://ddona.site/_ingest`)이라 Bugsink는
	# `FORCE_SCRIPT_NAME=/_ingest`로 DSN·링크를 만든다(공식 소스 bugsink/conf_utils.py
	# `deduce_script_name`, docker.py.template 확인). 하지만 `FORCE_SCRIPT_NAME`은 **URL 생성**만
	# 하지 **요청 라우팅**은 건드리지 않는다(Bugsink 공식 이슈 #93/#201 확인) — bugsink:8000
	# 컨테이너 자신은 `/_ingest` 프리픽스를 전혀 모른다. 그래서 여기서 `/_ingest`를 벗기고
	# 나머지 경로로 프록시한다(`handle_path`).
	#
	# 실제 envelope 경로는 `/_ingest/api/<project_id>/envelope/`다 — sentry-sdk가 DSN
	# `https://<key>@ddona.site/_ingest/<id>`에서 이 경로를 어떻게 계산하는지 이 저장소의
	# `apps/api/.venv/.../sentry_sdk/utils.py`(`Dsn`/`Auth.get_api_url`, 설치 버전 2.69.1)로
	# 직접 확인했다: `Dsn.path`는 DSN 경로에서 project_id를 뗀 나머지 + `/`(=`/_ingest/`), 그리고
	# `Auth.get_api_url`이 `f"{scheme}://{host}{path}api/{project_id}/envelope/"`을 조립한다.
	#
	# 시크릿은 이 envelope 경로에만 건다(사용자 결정) — 나머지 `/_ingest/*`(관리자 UI)는 Bugsink
	# 자체 로그인에 맡긴다. 시크릿의 목적은 DSN이 공개된 브라우저 ingest로 오는 익명 POST 홍수를
	# 막는 것이지 로그인 페이지를 숨기는 게 아니고, 가입은 이미 `CB_NOBODY`로 잠겨 있다(DEPLOY.md
	# 참조). 시크릿 값은 저장소에 없다 — Caddy 컨테이너의 `INGEST_SHARED_SECRET` 환경변수로 받는다
	# (`docker-compose.prod.yml`의 caddy 서비스에 배선돼 있다. 이 값이 완전히 빠지든 빈 문자열이든
	# 똑같이 아래 `header` 매처가 Caddyfile 파싱 자체를 깨뜨리므로, 배포 전 `/opt/ddona/.env`에
	# 값이 먼저 있어야 한다 — DEPLOY.md 참조).
	#
	# ⚠️ 안쪽을 `route { }`로 감싼 이유 — Caddy는 같은 블록의 서로 다른 지시어를 **작성 순서가
	# 아니라 자체 표준 순서**로 재배치한다(공식 문서). `route` 없이 쓰면 매처 없는 `respond 401`이
	# `reverse_proxy`보다 먼저 배치돼 **항상 401만 응답하고 reverse_proxy는 죽은 코드**가 된다 —
	# 로컬 caddy 컨테이너에 실제 요청을 보내 직접 재현·확인했다(올바른 시크릿을 보내도 401).
	handle_path /_ingest/* {
		route {
			@envelope_unauthorized {
				path /api/*/envelope/
				not header X-Ingest-Secret {$INGEST_SHARED_SECRET}
			}
			respond @envelope_unauthorized 401
			# ⚠️ Host 를 `ddona.site` 로 바꿔 보낸다. Worker 가 `ddona.site/_ingest/*` 를 받아
			# 여기(`api.ddona.site`)로 넘기는데, Caddy 가 Host 를 그대로 전달하면 Bugsink(Django)
			# 가 보는 Host 는 `api.ddona.site` 이고 브라우저가 보낸 Origin 은 `https://ddona.site`
			# 라 **둘이 달라 CSRF 가 거부된다**(실측: `Forbidden (Origin header does not match
			# (deduced) Host: 'https://ddona.site' != 'https://api.ddona.site')`). Bugsink 에는
			# `CSRF_TRUSTED_ORIGINS` 를 노출하는 설정이 없어(`docker.py.template` 확인) 프록시가
			# Host 를 맞추는 것이 유일한 해법이고, Bugsink 자신의 에러 메시지도 그 방식을 권한다
			# ("or configure proxy to use 'Host: ddona.site'"). `BASE_URL` 도 `ddona.site` 라
			# DSN·링크 생성과도 일치한다.
			reverse_proxy bugsink:8000 {
				header_up Host ddona.site
			}
		}
	}

	# 앱 컨테이너는 포트를 호스트에 노출하지 않는다 — 도커 내부 네트워크로만 닿는다.
	#
	# **`flush_interval -1` 은 일부러 넣지 않았다.** 채팅 응답이 `text/event-stream` 이라
	# 버퍼링되면 토큰이 한꺼번에 도착해 채팅이 고장난 것처럼 보이는데, Caddy 2 가 그 콘텐츠
	# 타입을 감지해 자동으로 flush 하는 것을 실측으로 확인했다 — 300ms 간격으로 5개를 흘리는
	# 백엔드를 두고 재보니 지시어가 있을 때(0.28/0.58/0.89/1.19s)와 없을 때
	# (0.30/0.60/0.91/1.21s)가 같았다. 결과를 바꾸지 않는 설정은 두지 않는다.
	# 언젠가 스트리밍이 뭉쳐서 도착하면 그때 여기에 `flush_interval -1` 을 넣어 보면 된다.
	reverse_proxy api:8000

	# 업로드는 브라우저가 R2로 직접 PUT 하므로 여기를 지나지 않는다. 그래도 본문 상한을 두어
	# 프록시가 임의 크기 요청을 받아주지 않게 한다. 사이트 블록 간 상속은 없지만(Caddy 공식
	# 문서) 이건 새 블록이 아니라 **이 블록 안**이라 `/_ingest/*`(위 handle_path)에도 그대로
	# 적용된다 — 로컬 caddy 컨테이너에 실제 요청을 보내 확인했다(11MB POST가 handle_path 안에서도
	# 413, 5MB POST는 정상 통과).
	request_body {
		max_size 10MB
	}

	encode gzip

	# 접근 로그는 개정 처리방침 제4조 5항이 약속한 "30일간 보관"을 지켜야 한다
	# (legal-revision-goal-prompt.md LR-13). Docker 기본 json-file 드라이버는 용량 기반
	# `max-size`/`max-file`만 있고 일수 기반 보관을 표현할 수 없어 stdout으로는 이 약속을
	# 지킬 수 없다 — 그래서 파일로 직접 출력하고 볼륨에 담는다(docker-compose.prod.yml).
	#
	# `roll_keep 0`이 반드시 있어야 한다(legal-revision-goal-prompt.md LR-24). Caddy 공식
	# 문서: "if log files are rotated daily, only 10 are kept based on the default
	# `roll_keep` value of `10`, regardless of the `roll_keep_for` setting." — 기본값 10을
	# 그대로 두면 트래픽이 하루 10MB(`roll_size`)를 넘겨 여러 번 롤링될 때 30일이 되기 전에
	# 파일이 지워진다. `0`은 "개수 제한 없음"으로, 보관기간은 `roll_keep_for`만으로 통제한다.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 0
			roll_keep_for 720h
		}
		# 비-TTY 환경(파일 출력)에서는 기본 포맷이 json으로 바뀐다(LR-26). 최종 검증이
		# "실제 로그 1줄과 처리방침 문안을 대조"하는 것이라 포맷을 명시적으로 고정한다.
		format console
	}
}
