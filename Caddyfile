# GCE VM 앞단 리버스 프록시. Let's Encrypt 인증서를 자동 발급·갱신한다.
#
# `SITE_ADDRESS` 가 이 파일의 유일한 변수다:
#   프로덕션  SITE_ADDRESS=api.ddona.site   → 자동 HTTPS(80은 443으로 리다이렉트)
#   로컬 검증 SITE_ADDRESS=http://localhost → 평문(인증서 발급 시도 안 함)
#
# ⚠️ 도메인을 쓸 때 Cloudflare DNS의 프록시(주황 구름)가 켜져 있으면 챌린지가 도달하지 못해
# 발급이 무한 실패한다. 반드시 DNS only(회색)로 둘 것.

{$SITE_ADDRESS} {
	# 앱 컨테이너는 포트를 호스트에 노출하지 않는다 — 도커 내부 네트워크로만 닿는다.
	#
	# **`flush_interval -1` 은 일부러 넣지 않았다.** 채팅 응답이 `text/event-stream` 이라
	# 버퍼링되면 토큰이 한꺼번에 도착해 채팅이 고장난 것처럼 보이는데, Caddy 2 가 그 콘텐츠
	# 타입을 감지해 자동으로 flush 하는 것을 실측으로 확인했다 — 300ms 간격으로 5개를 흘리는
	# 백엔드를 두고 재보니 지시어가 있을 때(0.28/0.58/0.89/1.19s)와 없을 때
	# (0.30/0.60/0.91/1.21s)가 같았다. 결과를 바꾸지 않는 설정은 두지 않는다.
	# 언젠가 스트리밍이 뭉쳐서 도착하면 그때 여기에 `flush_interval -1` 을 넣어 보면 된다.
	reverse_proxy api:8000

	# 업로드는 브라우저가 R2로 직접 PUT 하므로 여기를 지나지 않는다. 그래도 본문 상한을 두어
	# 프록시가 임의 크기 요청을 받아주지 않게 한다.
	request_body {
		max_size 10MB
	}

	encode gzip

	log {
		output stdout
		format console
	}
}
